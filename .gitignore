# Secrets – NIEMALS ins Git!
.env
.env.local
.env.*.local

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# macOS
.DS_Store

# IDE / Tools
.vscode/
.idea/
.claude/*
# ...außer den Agent-Definitionen – das ist wiederverwendbares Projekt-
# Tooling (Übungsreihen-Pipeline), kein persönliches Editor-Setting.
!.claude/agents/

# Logs
*.log

# Rohes Quellmaterial für die Übungsbank (u.a. urheberrechtlich sensibel,
# z.B. gescannte Verlags-Lehrwerke) + Zwischenstände der Agent-Pipeline.
# Gehört NIE ins Repo – nur der fertige, selbst geschriebene Output landet
# in Supabase. Siehe .claude/agents/ und docs/UEBUNGSBANK.md.
/material/

# Build artefacts
dist/
build/
supabase/.temp/

# Capacitor: native Projekte werden lokal erzeugt (brauchen Xcode/Android Studio).
# Sobald sie eingerichtet sind, sollten ios/ und android/ mit eingecheckt werden –
# dann diese beiden Zeilen entfernen.
/ios
/android
