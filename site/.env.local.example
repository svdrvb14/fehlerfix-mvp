# ─── Supabase ───
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# GEHEIM – niemals mit NEXT_PUBLIC_ Präfix, niemals im Browser verwenden.
# Nur serverseitig (API-Routen) für Schreibzugriffe ohne RLS-Einschränkung.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Stripe ───
# Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
# Stripe Dashboard → Developers → Webhooks → Signing secret
# (bzw. Ausgabe von `stripe listen` beim lokalen Testen)
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe Dashboard → Product catalog → die beiden Preise des Abos
NEXT_PUBLIC_STRIPE_PRICE_ID_MONTHLY=price_...
NEXT_PUBLIC_STRIPE_PRICE_ID_YEARLY=price_...
