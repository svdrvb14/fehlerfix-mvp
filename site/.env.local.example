# ─── Supabase ───
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# GEHEIM – niemals mit NEXT_PUBLIC_ Präfix, niemals im Browser verwenden.
# Nur serverseitig (API-Routen) für Schreibzugriffe ohne RLS-Einschränkung.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Stripe ───
# Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
# Stripe Dashboard → Developers → Webhooks → Signing secret
# (bzw. Ausgabe von `stripe listen` beim lokalen Testen)
STRIPE_WEBHOOK_SECRET=whsec_...

# Preismodell: Einzelsprache vs. Deutsch+Englisch, je monatlich/jährlich.
# Das Familienabo (2-4 Nutzer) ist über eine STRIPE-MENGENSTAFFEL
# (volume tiering) auf demselben Preis abgebildet, nicht über eigene
# Preise - die Website schickt beim Checkout die Nutzeranzahl als
# "quantity" mit, Stripe wendet dann automatisch den passenden Rabatt-Tier
# auf den Gesamtbetrag an.
#
# Einrichtung pro Preis in Stripe (Product catalog → Preis anlegen):
#   1. "Pricing model" → "Graduated"/"Volume" wählen, dann "Volume" (nicht
#      "Graduated") auswählen - alle Einheiten werden zum Preis der
#      erreichten Stufe abgerechnet.
#   2. "Customer chooses quantity" aktivieren.
#   3. Vier Stufen (tiers) mit "Preis pro Einheit" (unit_amount) anlegen:
#
#   Einzelsprache, monatlich (NEXT_PUBLIC_STRIPE_PRICE_ID_SINGLE_MONTHLY):
#     1 Nutzer  → 12,00 € / Nutzer
#     2 Nutzer  → 10,68 € / Nutzer   (Gesamt 21,36 €, −11 %)
#     3 Nutzer  →  9,36 € / Nutzer   (Gesamt 28,08 €, −22 %)
#     4 Nutzer  →  8,04 € / Nutzer   (Gesamt 32,16 €, −33 %)
#
#   Einzelsprache, jährlich (NEXT_PUBLIC_STRIPE_PRICE_ID_SINGLE_YEARLY):
#     1 Nutzer  → 89,99 € / Nutzer
#     2 Nutzer  → 80,09 € / Nutzer   (Gesamt 160,18 €, −11 %)
#     3 Nutzer  → 70,19 € / Nutzer   (Gesamt 210,57 €, −22 %)
#     4 Nutzer  → 60,29 € / Nutzer   (Gesamt 241,16 €, −33 %)
#
#   Deutsch + Englisch, monatlich (NEXT_PUBLIC_STRIPE_PRICE_ID_COMBO_MONTHLY):
#     1 Nutzer  → 15,00 € / Nutzer
#     2 Nutzer  → 13,35 € / Nutzer   (Gesamt 26,70 €, −11 %)
#     3 Nutzer  → 11,70 € / Nutzer   (Gesamt 35,10 €, −22 %)
#     4 Nutzer  → 10,05 € / Nutzer   (Gesamt 40,20 €, −33 %)
#
#   Deutsch + Englisch, jährlich (NEXT_PUBLIC_STRIPE_PRICE_ID_COMBO_YEARLY):
#     1 Nutzer  → 112,49 € / Nutzer
#     2 Nutzer  → 100,12 € / Nutzer  (Gesamt 200,24 €, −11 %)
#     3 Nutzer  →  87,74 € / Nutzer  (Gesamt 263,22 €, −22 %)
#     4 Nutzer  →  75,37 € / Nutzer  (Gesamt 301,48 €, −33 %)
#
# Diese Beträge sind exakt mit site/lib/pricing.ts abgestimmt - ändert sich
# einer davon, bitte in beiden Dateien anpassen.
NEXT_PUBLIC_STRIPE_PRICE_ID_SINGLE_MONTHLY=price_...
NEXT_PUBLIC_STRIPE_PRICE_ID_SINGLE_YEARLY=price_...
NEXT_PUBLIC_STRIPE_PRICE_ID_COMBO_MONTHLY=price_...
NEXT_PUBLIC_STRIPE_PRICE_ID_COMBO_YEARLY=price_...
