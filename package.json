{
  "name": "fehlerfix",
  "version": "1.0.0",
  "description": "FehlerFix – KI-gestützte, adaptive Rechtschreib-Lern-App für Kinder der Klassen 3–7",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "mobile:api": "node scripts/set-api-base.js",
    "mobile:add:ios": "cap add ios",
    "mobile:add:android": "cap add android",
    "mobile:sync": "cap sync",
    "mobile:open:ios": "cap open ios",
    "mobile:open:android": "cap open android",
    "mobile:build": "node scripts/set-api-base.js https://fehlerfix.onrender.com && cap sync",
    "test": "node test/mastery.test.js && node test/exercises.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@capacitor/app": "^8.1.1",
